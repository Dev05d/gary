# ---------------------------------------------------------------------------
# Gary — Local Personal Intelligence Agent
# Copy to `.env` and edit.  NEVER commit `.env`.
# ---------------------------------------------------------------------------

# --- Ollama ----------------------------------------------------------------
# Point this at ANY machine on your LAN running Ollama, e.g.
#   http://localhost:11434          (same Mac)
#   http://192.168.1.42:11434       (the beefy desktop in the other room)
#   http://ollama.local:11434       (mDNS hostname)
# NOTE: on the *serving* machine you must start Ollama with
#   OLLAMA_HOST=0.0.0.0 ollama serve
# otherwise it only listens on loopback and the LAN can't reach it.
OLLAMA_BASE_URL=http://localhost:11434

# Optional: run embeddings on a *different* box than chat (leave blank to reuse
# OLLAMA_BASE_URL).  Useful if one machine has the big GPU and another is idle.
OLLAMA_EMBED_BASE_URL=

# Seconds to wait for a generation to start/continue. Big models on a remote
# box over WiFi can be slow to first token; raise if you see timeouts.
OLLAMA_TIMEOUT=300

# Keep the model resident in VRAM between requests ("5m", "1h", "-1" = forever).
OLLAMA_KEEP_ALIVE=5m

# --- Models ----------------------------------------------------------------
# NOTHING here is hard-coded in the source. Set these to whatever
# `ollama list` shows on the serving machine.
#
# LARGE  -> complex questions, multi-step reasoning, agent planning
# FAST   -> classification, extraction, short summaries, query routing
# EMBED  -> vector embeddings (M3)
LLM_MODEL_LARGE=gemma3:27b
LLM_MODEL_FAST=gemma3:12b
LLM_MODEL_ROUTER=gemma3:12b
EMBEDDING_MODEL=qwen3-embedding:4b

# --- Context windows -------------------------------------------------------
# num_ctx passed to Ollama, per role. Bigger = more memory on the GPU/host.
# 32k is comfortable on a 32GB+ machine with a 27B model; drop to 8192 if you
# see the model getting evicted to CPU / crawling.
LLM_CONTEXT_LARGE=32768
LLM_CONTEXT_FAST=8192
LLM_CONTEXT_ROUTER=8192

# Tokens reserved for the model's own reply (subtracted from the budget above).
LLM_GENERATION_BUFFER=2048

LLM_TEMPERATURE=0.3

# --- Storage ---------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/gary.db
DATA_DIR=./data

# --- Server ----------------------------------------------------------------
# 127.0.0.1 means: not reachable from the network. Change ONLY if you know
# what you're doing and have set API_AUTH_TOKEN below.
APP_HOST=127.0.0.1
APP_PORT=8000

# Leave blank for no auth (safe while bound to 127.0.0.1).
# If you bind to 0.0.0.0 the app REFUSES to start without this set.
API_AUTH_TOKEN=

# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO

# --- Google (Milestone 2 — not used yet) -----------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback
# 32-byte urlsafe base64 key used to encrypt OAuth tokens at rest.
# Generate with:  python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIAL_ENCRYPTION_KEY=
